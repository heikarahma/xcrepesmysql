VITE_APP_TITLE="XCrepes POS"
VITE_APP_PORT=5173
VITE_APP_HOST="0.0.0.0"

# Server-only: gunakan salah satu format koneksi MySQL berikut.
# Jangan pernah memakai prefix VITE_ untuk credential database.
MYSQL_URL=mysql://user:password@host:3306/xcrepes
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=xcrepes
# MYSQL_PASSWORD=ganti-password-database
# MYSQL_DATABASE=xcrepes

# Provider cloud umumnya membutuhkan TLS. Untuk MySQL lokal gunakan MYSQL_SSL=false.
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_CONNECTION_LIMIT=5

# Server-only: minimal 32 karakter. Buat nilai acak khusus production.
AUTH_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Hanya dipakai npm run db:setup untuk membuat akun awal.
INITIAL_ADMIN_PASSWORD=ganti-password-admin-minimal-8-karakter

# Opsional: frontend terpisah dari deployment API.
# Kosongkan saat frontend dan API sama-sama di Vercel.
VITE_API_BASE_URL=
# Satu polling bersama untuk seluruh layar aktif. Minimum yang diterima aplikasi: 60000 ms.
VITE_REALTIME_POLL_MS=120000

# Hanya dibutuhkan sementara saat menjalankan npm run db:migrate.
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ganti-service-role-key
